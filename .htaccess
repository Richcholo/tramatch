# ---------------------------------------------------------------------------
# Root .htaccess — only read when the application root IS the document root.
#
# Two deployment layouts exist for this app, and which one you are running
# decides which .htaccess the server actually reads:
#
#   Layout A — application root at ~/domains/<domain>/, with public_html a
#              symlink to public/. The document root is therefore public/, so
#              the server reads public/.htaccess and never this file. The deny
#              rules live in public/.htaccess.
#
#   Layout B — application root inside public_html/, which is what you get when
#              uploading through the control panel or following the Hostinger
#              guide. Then this file is read first, and it has to route every
#              request into public/ because Hostinger will not change a Web
#              plan's document root.
#
# The deny rules below are NOT optional in this layout. With the application
# root inside the document root, .env, vendor/, storage/logs/ and config/ are all
# reachable over HTTP unless they are refused here. That has already happened
# once: storage/logs/laravel.log was served with a 200, carrying the database
# password and APP_KEY.
#
# They are duplicated in public/.htaccess rather than living in one place,
# because which file is read depends on the layout. Both copies refuse the same
# paths, so whichever layout you deploy, the answer is the same.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Deny application source and framework internals. These are refused outright
# rather than forwarded, so a path that reaches this file never gets a chance to
# be served. RedirectMatch 404 is the standard idiom for this; note it matches
# against the original REQUEST_URI, which an internal rewrite does not change,
# so these hold whether or not the forward rule below has run.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(app|bootstrap|config|database|deploy|routes|tests|vendor)(/|$)
    RedirectMatch 404 ^/storage/(app|framework|logs|private|testing)(/|$)
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Everything else goes into public/, where Laravel's own .htaccess hands off
    # to the front controller. The condition stops requests already under
    # /public/ being rewritten a second time, which is the usual cause of the
    # "the page isn't redirecting properly" loop.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<FilesMatch "(^\.env|\.env\.(example|production|backup)|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan$|(^|/)\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Never offer a directory index. public_html/ contains the whole application,
# so a listing there would enumerate app/, config/, database/ and vendor/.
Options -Indexes