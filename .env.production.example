# Production environment template.
#
# Copy to .env on the server and fill in the blanks:
#     cp .env.production.example .env
#
# Do NOT copy .env.example for production. That one is deliberately tuned for
# local development (sqlite, APP_DEBUG=true, mail to the log) and several of
# those settings are unsafe or silently broken in production.
#
# Every value marked CHANGE ME must be edited before the first request.

# ---------------------------------------------------------------- application

# CHANGE ME
APP_NAME=TraMatch
APP_ENV=production
# Must be false. With it on, any unhandled error renders a stack trace that can
# include file paths, environment variables and query text to whoever triggered
# it. This app walks the catalogue and talks to third-party hosts, so exceptions
# are reachable.
APP_DEBUG=false
# CHANGE ME - no trailing slash.
APP_URL=https://yourdomain.tld

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# config/app.php reads env('APP_TIMEZONE'), so this takes effect. See AGENTS.md:
# timestamps written before that config line was fixed are UTC wall-clock and
# read 8 hours early.
APP_TIMEZONE=Asia/Manila

# Leave empty here and run `php artisan key:generate --force` on the server.
# Generating it locally and copying it over is fine too, as long as it is not
# committed.
APP_KEY=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------- database

# CHANGE ME - Hostinger supplies all four under Databases -> MySQL.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Hostinger prefixes the database and user with your account name, e.g.
# u348491703_tramatch. Use the exact values from the hPanel page.

# Sessions, cache and the queue all share the database driver, so the migration
# chain has to create every one of those tables.
# CHANGE ME - 600, not 90. See config/queue.php: retry_after must exceed the
# 300s crawl timeout or a slow crawl is handed to a second worker mid-fetch and
# runs twice. Deriving it from QUEUE_WORKER_TIMEOUT below is the safer route;
# only set this if you need to override it.
DB_QUEUE_RETRY_AFTER=

# -------------------------------------------------------------- queue worker

# Seconds a worker allows one job. A crawl sleeps 5s then makes two HTTP
# requests, so give it room. config/queue.php derives retry_after from this.
QUEUE_WORKER_TIMEOUT=300

# -------------------------------------------------------------------- session

# Sessions live in the database, so they survive across requests without a
# file store. Required because a load balancer would otherwise log people out.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Set once the site is served over HTTPS. With this null Laravel still sends the
# cookie over plain HTTP, which is correct locally and wrong in production.
SESSION_SECURE_COOKIE=true

# ----------------------------------------------------------------------- cache

CACHE_STORE=database

# ----------------------------------------------------------------------- queue

QUEUE_CONNECTION=database

# ----------------------------------------------------------------------- mail

# CHANGE ME. 'log' is a local-only setting and it breaks two live flows:
# forgot-password calls Password::sendResetLink(), and routes/auth.php has the
# verification resend. With the log mailer a traveller is told the link is on
# its way, nothing is sent, and the only trace is the link itself in
# storage/logs/laravel.log. Hostinger includes a mailbox on this plan.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# CHANGE ME - the full address, and the mailbox password, not the hPanel login.
MAIL_USERNAME=
MAIL_PASSWORD=
# CHANGE ME - use a real address you control; some hosts reject anything else.
MAIL_FROM_ADDRESS="hello@yourdomain.tld"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------- logging

# 'stack' + 'single' writes storage/logs/laravel.log. Check that directory is
# writable by the web user or logging fails silently and you lose the evidence
# for any of the failures above.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' in production records every query and bloats the log fast. 'warning'
# is the useful level; drop to 'info' while diagnosing.
LOG_LEVEL=warning

# ------------------------------------------------------------------- filesystem

FILESYSTEM_DISK=local

# ------------------------------------------------------------------- crawler

# The address in the crawler User-Agent. config/crawling.php builds the
# User-Agent from crawling.token plus this, and RobotsPolicyService matches
# robots.txt groups on crawling.token, which must stay a prefix of it.
#
# Real address rather than a `yourdomain.tld` placeholder: a deploy that does not
# edit this ships a crawler identifying itself as `+mailto:admin@yourdomain.tld`,
# which is a mailbox nobody can reach, and it breaks nothing visibly. The address
# is monitored, so a site owner who is being crawled too hard can reply and stop
# it. That reachability is the entire point of an identifiable crawler.
CRAWLER_CONTACT=support@tramatch.site

# ------------------------------------------------------------------- planning
#
# Blank by default and blank is CORRECT until you have a key. There is no code
# path that calls either API yet, so a deploy without these keys behaves exactly
# as it did before, and leaving a placeholder here would be worse than leaving it
# empty: an empty key reports "not configured", while a placeholder issues a real
# request that fails and looks like an outage.
#
# SERVER SIDE ONLY. A Gemini key in shipped JavaScript is a public key. It must
# not appear in a `@vite` entry, a <meta> tag or a data attribute, and no
# endpoint in this app returns config.
#
# A Gemini subscription for the Gemini app is NOT an API entitlement. Issue this
# from AI Studio for the developer API and check that project's rate limits
# there. On the free tier, content sent is used to improve Google's products, so
# send place records and trip constraints -- never a traveller's name, email,
# booking reference or notes.
GEMINI_API_KEY=
# Google retires models, and a retired one answers 404 -- which the traveller
# sees as "the suggestion service is not answering right now", the same message
# a dead host produces. Read the planning.gemini_* line in storage/logs before
# assuming an outage: it carries the status and the provider's own words.
GEMINI_MODEL=gemini-3.8-flash
# THE OUTPUT BUDGET HAS TO COVER THE THOUGHTS, NOT JUST THE ANSWER. These are
# thinking models: reasoning tokens are billed against the same maxOutputTokens,
# and a 3-pick reply was measured at 577 thoughts against 112 answer tokens.
# Too small a number truncates the JSON mid-string and the assist reports
# "ran long and was cut off". 8192 is a ceiling, not a spend.
PLANNING_ASSIST_OUTPUT_TOKENS=8192

# Routing. Blank means every itinerary leg stays `route_status = unresolved` and
# the page says the distance was not resolved. That is the honest state and is
# better than the flat 45-minute estimate every stop used to carry.
ROUTING_API_KEY=
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=

# HTTP-level bounds rather than queue job properties, because config/queue.php
# derives retry_after from QUEUE_WORKER_TIMEOUT and the cron worker's
# `queue:drain` calls $job->fire() directly without enforcing a job's $timeout.
# These bounds the work themselves.
PLANNING_ROUTING_TIMEOUT=8
ROUTING_CACHE_DAYS=30
ROUTING_USER_AGENT=TraMatch/1.0 (+mailto:support@tramatch.site)
PLANNING_TIMEOUT=90
PLANNING_JOB_BUDGET=240
PLANNING_MAX_CANDIDATES=40
PLANNING_MAX_ATTEMPTS=2
PLANNING_COOLDOWN=15

# -------------------------------------------------------------------- vite

# Only read at build time. Changing it on the server does nothing, because the
# compiled assets in public/build were built on a developer machine and are
# committed.
VITE_APP_NAME="${APP_NAME}"