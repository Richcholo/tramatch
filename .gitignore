# public/build IS tracked. The production host has no Node.js, so Vite cannot
# run there; the compiled assets have to arrive with `git pull` or the site
# renders unstyled. Run `npm run build` and commit the result whenever you
# change anything under resources/css or resources/js.
/public/fonts-manifest.dev.json
/public/hot
/public/storage
# Host artifacts, not project files. deploy/setup-website.sh creates the
# public_html symlink on the server (Hostinger will not change a Web plan's
# document root), and deploy/queue-worker.sh is copied into $HOME so cron can
# reach it. Without these, deploy.sh's dirty-tree guard blocks every deploy
# because of files the deployment itself created.
/public_html
/public_html.hostinger-backup
/queue-worker.sh
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
