# E2E environment. Copied to .env.e2e by `npm run e2e:setup`, which also
# generates an APP_KEY. Never committed, never a real secret: this database is a
# throwaway SQLite file that setup deletes and rebuilds on every run.
#
# It exists because the browser suite needs a REAL server and a REAL seeded
# database. `php artisan test` runs on `:memory:` SQLite with array cache and
# cannot serve HTTP at all.

APP_NAME=TraMatch
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123
APP_TIMEZONE=Asia/Manila

# A FILE on disk, deliberately. The app under test has to read the same rows a
# browser reads, which an in-memory database cannot do across two processes.
#
# NEVER POINT THIS AT MYSQL. setup deletes this file and rebuilds it; against a
# development database that would drop your catalogue.
DB_CONNECTION=sqlite
# DB_DATABASE is resolved by the setup script to an absolute path so this file
# does not depend on the working directory.

CACHE_STORE=array
# SESSION_DRIVER=array IS WRONG HERE, and it fails in a way that looks like a
# broken app rather than a broken environment. `array` keeps sessions in memory
# for the lifetime of ONE request, which is exactly right for `php artisan test`
# (the whole suite is one process) and exactly wrong for a browser talking to a
# server across two. Registration would succeed, the server would redirect to
# /dashboard, no session cookie would come back, and every later request would
# arrive anonymous and be bounced to /login.
#
# `file` persists across processes. The files land in storage/framework/sessions,
# which is gitignored. Playwright starts each run with a fresh browser context,
# so a stale session file from a previous run is harmless.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Left blank on purpose. There is no Gemini client yet (Phase 3), and the
# browser suite must never depend on a quota.
GEMINI_API_KEY=
GEMINI_MODEL=

# Routing resolves legs against a shared public demo server from this test
# run. That makes the suite slow, flaky, and dependent on someone else's uptime,
# so the stub in tests/TestCase.php does not apply here. A future revision
# should point ROUTING_BASE_URL at a local OSRM or assert against the
# degraded-but-honest path instead.
ROUTING_PROVIDER=osrm
ROUTING_CACHE_DAYS=30
# QUOTED, and not by accident. dotenv parses an unquoted value up to the first
# whitespace, so a User-Agent with a space in it — which is required, since
# "TraMatch/1.0" alone is exactly the anonymous-looking string the provider
# refuses — fails the whole file to parse with an error naming the value.
ROUTING_USER_AGENT="TraMatch/1.0 (+mailto:support@tramatch.site)"
PLANNING_ROUTING_TIMEOUT=8