APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# MySQL is what a real host gives you. Uncomment these and point DB_CONNECTION at
# mysql; sqlite here is only so a fresh clone runs with no credentials at all.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds a worker gives a single job before killing it. config/queue.php derives
# retry_after from this (plus 60s), so retry_after can never drop below the
# worker's timeout and hand the same crawl to two workers at once.
QUEUE_WORKER_TIMEOUT=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# 'log' is right locally: the link lands in storage/logs/laravel.log.
# It is NOT right in production. Two live flows call the mailer -- forgot-password
# via Password::sendResetLink() and the resend on routes/auth.php
# (verification.notice / verification.send). With the log mailer a traveller is
# told the link is on its way and it never arrives, and the only trace is the
# link itself in the log. Set MAIL_MAILER=smtp plus the real host, port, username
# and password from your mail provider before going live.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The crawler User-Agent contact. Not a placeholder: a bot that identifies itself
# with an address nobody can read cannot be complained to, which is the whole
# reason to send one. Change it only if the site gets a different address.
CRAWLER_CONTACT=support@tramatch.site

# ------------------------------------------------------------------- planning
#
# NOT READ BY ANY CODE YET. `places`, the extended `itinerary_items` and
# config/planning.php exist as of Day 1; no HTTP client, job or route uses these
# yet. They are listed so the credential shape is settled and so the first person
# who adds the client does not also have to add keys to three env files.
#
# The Gemini key is SERVER-SIDE ONLY. It must never appear in a `@vite` entry, a
# <meta> tag or a data attribute: a key in shipped JavaScript is a public key that
# anyone can lift and spend against your quota.
#
# Get it from AI Studio, which issues a key for the developer API. A Gemini
# subscription for the Gemini app is a separate billing arrangement and does not
# create an API entitlement -- check the project's rate limits in AI Studio before
# assuming a quota.
#
# Leave GEMINI_API_KEY blank locally. A blank key is the correct local state, and
# the client will report "not configured" rather than issuing a request that fails.
GEMINI_API_KEY=
# The model id is an env var on purpose: Google retires models, and a hard-coded
# id in config/services.php would be one more thing to rot silently. This default
# is the one Google's own 404 named when it retired gemini-2.5-flash; if the
# assist starts failing with "the suggestion service is not answering", read the
# planning.gemini_* log line before changing anything else -- it names the status
# and the provider's message.
GEMINI_MODEL=gemini-3.8-flash

# Route distances and travel times. A blank key means every leg stays
# `route_status = unresolved` and the UI says so, which is the honest state --
# never a flat estimate presented as a real distance.
ROUTING_API_KEY=
ROUTING_PROVIDER=osrm
# Leave blank unless you are pointing at a self-hosted or proxied provider.
ROUTING_BASE_URL=

# ----------------------------------------------------------------- scheduling
#
# HTTP-level bounds, NOT queue job properties. config/queue.php derives
# retry_after from QUEUE_WORKER_TIMEOUT, and `queue:drain` on Hostinger calls
# $job->fire() directly, so a job's own $timeout is not enforced there. These
# have to bound the work themselves.
#
# planning must finish inside job_budget, which is under the 300s crawl timeout
# and well under retry_after.
PLANNING_ROUTING_TIMEOUT=8
ROUTING_CACHE_DAYS=30
ROUTING_USER_AGENT=TraMatch/1.0 (+mailto:support@tramatch.site)
PLANNING_TIMEOUT=90
PLANNING_JOB_BUDGET=240
# One request per generation, at most two attempts (proposal + one repair). Never
# a loop. These are caps, not targets: opening, editing and exporting a SAVED
# itinerary makes no calls at all.
PLANNING_MAX_CANDIDATES=40
PLANNING_MAX_ATTEMPTS=2
PLANNING_COOLDOWN=15
